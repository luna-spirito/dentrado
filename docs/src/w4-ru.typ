= Пример формальной верификации свойства незначимсти кэша <valid-invalid-gear-code>
```
unpack ./std. Int+ Type Kind Opt _=>_ _+_ _-_ _*_ unit loop_iter iter_list opt_unwrap Not
unpack fadeno.
  Tag Int Bool if Eq List refl Any
  ~query_events ~mk_primary ~mk_secondary
  Primary Secondary
  EventTypeId mk_event_type un_event_type
  LocEventId resolve_event
  Id DataId resolve_data
  UserId sender-to>user user_eq
  Gear mk_gear
  Query mk_query query_delta
  StateGraph StateGraphOut mk_stategraph stategraph_apply stategraph_out
    sgctx_query sgctx_update sgctx_dep_query
  secondary_get
  TextUpd
    AnchorAgg mk_anchor_agg anchor_agg_apply
    TextAgg mk_text_agg text_agg_apply text_agg_merge
  Timestamp

// "core"

// Events are defined by listing their "group" (fields) and body.
/: Kind
EventDef =
 {(.key = Tag | .group = Type | .body = Type)}

/: Fun {t} {Acc} ({( .removed = List t | .added = List t )}) (Fun (t) (Acc) -> Acc) (Fun (t) (Acc) -> Acc) (Acc) -> Acc
query_apply_diff = \delta f b x.
  loop_iter
    (iter_list delta.added)
    f
    (loop_iter
      (iter_list delta.removed)
      b
      x
    )

/: Fun {id : EventTypeId} {Acc} (Query id) (Fun (LocEventId id) (Acc) -> Acc) (Acc) -> Acc
~query_apply_full = \query f x.
  loop_iter
    (iter_list (~query_events query))
    f x

/: Fun {id : EventTypeId} (f : Fun (LocEventId id) -> Int) (q : Query id) (p : Primary) (init : Int) -> Eq
  (query_apply_diff (query_delta q p).delta (\v agg. agg + f v) (\v agg. agg - f v)
    (~query_apply_full q (\v agg. agg + f v) init))
  (~query_apply_full (query_delta q p).query (\v agg. agg + f v) init)
~fold_p~fold_p_fold_m = SORRY

/: Fun {id : EventTypeId} (q1 : Query id) (q2 : Query id) (p : Primary) -> Eq (query_delta q1 p).query (query_delta q2 p).query
~query_delta_same = SORRY

// "end core"

/: EventTypeId
MulSumEntry = mk_event_type
  { .key = .MulSumEntry
  | .group = Int+
  | .body = {( .a = Int | .b = Int )}
  }

// `ValidGear Cache f` is a proof that, given ANY
// cache of type `Cache`, `f` over that cache satisfies the
// cache-irrelevance property
/: Fun {u} {Out} (Cache : fadeno.Type^ u) (s : Fun (Cache) (Primary) (Secondary) -> {( .cache = Cache | .out = Out )}) -> fadeno.Type^ u
ValidGear = \Cache f.
  Fun (cache1 : Cache) (cache2 : Cache) (primary : Primary) (secondary : Secondary)
    -> Eq (f cache1 primary secondary).out (f cache2 primary secondary).out

/: Fun (Query MulSumEntry) -> Int
mulsum_pure = \query. loop_iter
  (iter_list (~query_events query))
  (\v agg.
    v = (resolve_event v).body
    in agg + (v.a * v.b))
  0

/: Type
MSCache =
  {(.query = Query MulSumEntry
  | .agg = Int
  )} \./ {( .is_pure = Eq ..agg (mulsum_pure ..query) )}

/: MSCache
initial_cache = { .query = mk_query | .agg = 0 } \/ { .is_pure = refl }

/: Fun (MSCache) (Primary) (Secondary) -> {( .cache = MSCache | .out = Int )}
step = \cache primary _secondary.
  res = query_delta cache.query primary
  /: Int
  agg =
    loop_iter
      (iter_list res.delta.added)
      (\v agg.
        v = (resolve_event v).body
        in agg + (v.a * v.b))
      (loop_iter
        (iter_list res.delta.removed)
        (\v agg.
          v = (resolve_event v).body
          in agg - (v.a * v.b))
        cache.agg
      )
  /: Eq agg (mulsum_pure res.query)
  ~identical =
    rewrite cache.is_pure
    rewrite ~fold_p~fold_p_fold_m @MulSumEntry (\v. v = (resolve_event v).body in v.a * v.b) cache.query primary 0
    in refl
  /: MSCache
  cache = { .query = res.query | .agg = agg } \/ { .is_pure = ~identical }
  in { .cache = cache | .out = agg }

/: ValidGear MSCache step
valid = \cache1 cache2 primary secondary.
  res1 = step cache1 primary secondary
  res2 = step cache2 primary secondary
  rewrite ~query_delta_same @MulSumEntry cache1.query cache2.query primary
  rewrite res1.cache.is_pure
  rewrite res2.cache.is_pure
  in refl

/: Fun (Int+) -> Gear Int
mulsum = \bucket. mk_gear
  { .primary = { .type = MulSumEntry | .group = bucket }
  | .initial_cache = initial_cache
  | .step = step
  }

// The same thing, but we've dropped a critical constraint on MSCache:

/: Type
MSCacheInvalid =
  {(.query = Query MulSumEntry
  | .agg = Int
  )}

/: MSCacheInvalid
initial_cache_invalid = { .query = mk_query | .agg = 0 }

/: Fun (MSCache) (Primary) (Secondary) -> {( .cache = MSCacheInvalid | .out = Int )}
step_invalid = \cache primary _secondary.
  res = query_delta cache.query primary
  /: Int
  agg =
    loop_iter
      (iter_list res.delta.added)
      (\v agg.
        v = (resolve_event v).body
        in agg + (v.a * v.b))
      (loop_iter
        (iter_list res.delta.removed)
        (\v agg.
          v = (resolve_event v).body
          in agg - (v.a * v.b))
        cache.agg
      )
  /: MSCacheInvalid
  cache = { .query = res.query | .agg = agg }
  in { .cache = cache | .out = agg }

/: Not (ValidGear MSCacheInvalid step_invalid)
invalid = \impl.
  /: Eq 0 1
  absurd = impl { .query = mk_query | .agg = 0 } { .query = mk_query | .agg = 1 } ~mk_primary ~mk_secondary
  in absurd

in
  { .MulSumEntry = MulSumEntry
  | .mulsum = mulsum
  | .valid = valid
  | .invalid = invalid
  }
```

= Исходный код Fadeno для теста системы контроля версий <wiki-fadeno-test>
```
unpack ./std. Type Opt _=>_ _+_ unit loop_iter iter_list opt_unwrap
unpack fadeno.
  Tag Bool if
  EventTypeId mk_event_type
  resolve_event
  Id DataId resolve_data
  UserId sender-to>user user_eq
  Gear mk_gear
  Query mk_query query_delta
  StateGraph StateGraphOut mk_stategraph stategraph_apply stategraph_out
    sgctx_query sgctx_update sgctx_dep_query
  secondary_get
  TextUpd
    AnchorAgg mk_anchor_agg anchor_agg_apply
    TextAgg mk_text_agg text_agg_apply text_agg_merge
  Timestamp

// Begin core

// Events are defined by listing their "group" (fields) and body.
EventDef =
 {(.key = Tag | .group = Type | .body = Type)}

// End core

Branch = DataId {( .creator = UserId | .created_at = Timestamp )}
Doc = Id

// "Invite" user to the branch.
/: EventTypeId
Invite = mk_event_type
 { .tag = .Invite
 | .group = Branch
 | .body = UserId
 }

UpdatePayload =
  {( .is_merge = Bool )} \./
    if ..is_merge
      // This is fork event
      {( .from = Branch )}
      // This is just a textual update
      {( .edit = TextUpd )}

// Attach edit to the document on the branch.
/: EventTypeId
Attach = mk_event_type
  { .tag = .Attach
  | .group = Doc
  | .body = {( .branch = Branch )} \./ UpdatePayload
  }

// Logic

/: Fun (Branch) -> Gear (StateGraphOut UserId Bool) // is user invited?
invited = \branch.
  creator = (resolve_data branch).creator
  in mk_gear
    { // primary input: union variant "event table", with event type Invite and group fields matching `branch`
      .primary = { .tag = .event_table | .type = Invite | .group = branch }
      // initial cache: input query & associated counter
    | .initial_cache = { .query = mk_query | .sg = mk_stategraph }
      // step function
    | .step = \cache primary _secondary.
      q_res = query_delta cache.query primary // .res : DeltaList (LocEventId Invite)
      sg = stategraph_apply
        cache.sg
        (\event_id.
          event = resolve_event event_id
          sender = sender-to>user event.sender
          sender_invited = opt_unwrap (sgctx_query sender) (\_. user_eq sender creator)
          in if sender_invited
          (
              sgctx_update event.body true // mark as invited
          )
          (unit)
        )
      (\never. never) // dep resolver
      q_res.delta
      in { .cache = { .query = q_res.query | .sg = sg } | .out = stategraph_out sg }
    }

/: Fun (Doc) -> Gear {( .anchors = AnchorAgg | .text = StateGraphOut Branch TextAgg )}
doc_content = \doc. mk_gear
  { .primary = { .tag = .event_table | .type = Attach | .group = doc }
  | .initial_cache = { .query = mk_query | .anchors = mk_anchor_agg | .sg = mk_stategraph }
  | .step = \cache primary secondary.
    res = query_delta cache.query primary
    anchors = loop_iter
      (iter_list res.delta.added)
      (\upd anchors.
        body = (resolve_event upd).body
        in if body.is_merge
          anchors
          (anchor_agg_apply anchors upd body.edit))
      cache.anchors
    dep_resolver = \branch. secondary_get (invited branch)
    sg = stategraph_apply
      cache.sg
      (\event_id.
        // Resolve the event to get sender and body
        event = resolve_event event_id
        // Check if the author is invited on this branch
        creator = (resolve_data event.body.branch).creator
        sender = sender-to>user event.sender
        is_invited = opt_unwrap (sgctx_dep_query event.body.branch sender) (\_. user_eq sender creator)
        in if is_invited
          ( curr_text_agg = opt_unwrap (sgctx_query event.body.branch) (\_. mk_text_agg)
          in
            sgctx_update event.body.branch
              (if event.body.is_merge
                (text_agg_merge curr_text_agg (opt_unwrap (sgctx_query event.body.from) (\_. mk_text_agg)))
                (text_agg_apply curr_text_agg event_id event.body.edit))
          )
          unit
      )
      dep_resolver
      res.delta
    in { .cache = { .query = res.query | .anchors = anchors | .sg = sg } | .out = { .anchors = anchors | .text = stategraph_out sg } }
  }

in
  { .Invite = Invite
  | .Attach = Attach
  | .invited = invited
  | .doc_content = doc_content
  }
